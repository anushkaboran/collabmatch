# Copy to .env.local (never commit .env.local). Everything works with all of these empty:
# the database falls back to memory, Gemini to keyword parsing, Instagram to a sample creator.

# MongoDB Atlas (MLH Atlas track). Required on Vercel, because memory isn't shared between serverless instances.
MONGODB_URI=
MONGODB_DB=collabmatch

# Gemini (MLH Gemini track). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Instagram API with Instagram Login (Meta developer app → Instagram → API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Demo: seed creators other than Maya reply on their own a few seconds after an invite. "false" turns it off.
DEMO_SIMULATED_REPLIES=true

# Frontend: "true" runs the whole app in the browser with no server (offline demo backup).
NEXT_PUBLIC_USE_MOCKS=false
